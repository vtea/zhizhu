{
  "name": "zhizhu",
  "private": true,
  "description": "知竹：Web 控制台（apps/web）+ 本地客户端（apps/client）+ 工具（tools/）",
  "workspaces": [
    "apps/web",
    "apps/client",
    "apps/api",
    "tools/playwright-field-probe",
    "e2e-playwright-zhizhu-web"
  ],
  "scripts": {
    "build:web": "npm run build -w @zhizhu/web",
    "build:client": "npm run build -w @zhizhu/client",
    "build:api": "npm run build -w @zhizhu/api",
    "build": "npm run build:web && npm run build:client && npm run build:api",
    "migrate:api": "npm run migrate -w @zhizhu/api",
    "dev:client": "npm run start -w @zhizhu/client",
    "test:e2e": "npm run test:e2e -w zhizhu-e2e-playwright"
  }
}
