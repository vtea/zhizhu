{
  "name": "@zhizhu/client",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "version": "0.1.0",
  "description": "知竹本地客户端（Electron）：数据面入口，用系统浏览器打开 Web 控制台",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build:client": "npm run build",
    "build": "npm --prefix ../../packages/playwright-rule-schema run build && npm --prefix ../../packages/biz-account-auth-status run build && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && npm run build:css && npm run build:renderer",
    "build:css": "tailwindcss -i src/renderer/styles.css -o dist/styles.css --minify",
    "build:renderer": "esbuild src/renderer/main.tsx --bundle --format=iife --platform=browser --outfile=dist/renderer.js --jsx=automatic --loader:.tsx=tsx --loader:.ts=ts --sourcemap",
    "watch": "tsc -p tsconfig.json -w",
    "watch:css": "tailwindcss -i src/renderer/styles.css -o dist/styles.css --watch",
    "watch:renderer": "esbuild src/renderer/main.tsx --bundle --format=iife --platform=browser --outfile=dist/renderer.js --jsx=automatic --loader:.tsx=tsx --loader:.ts=ts --sourcemap --watch",
    "test": "tsx --test \"src/**/*.unit.test.ts\"",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "prepack:env:dy": "node -e \"require('node:fs').copyFileSync('.env.pack.dy','.env')\"",
    "pack:mac": "npm run build && electron-builder --mac dmg --publish never",
    "pack:win": "npm run build && node ../../scripts/electron-builder-cache-warm.mjs && electron-builder --win nsis --publish never",
    "pack:mac:dy": "npm run prepack:env:dy && npm run pack:mac",
    "pack:win:dy": "npm run prepack:env:dy && npm run pack:win",
    "pack:all": "npm run build && electron-builder --mac dmg --win nsis --publish never"
  },
  "dependencies": {
    "@zhizhu/biz-account-auth-status": "*",
    "@zhizhu/playwright-shell-contract": "*",
    "@zhizhu/playwright-rule-schema": "*",
    "@zhizhu/runner": "0.1.0",
    "dotenv": "^16.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.4",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.2",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "~5.8.0"
  },
  "build": {
    "appId": "com.zhizhu.client",
    "productName": "知竹",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "index.html",
      "package.json",
      ".env"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
