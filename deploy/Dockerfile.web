# 知竹 Web 静态资源 + Nginx（仓库根为构建上下文：`docker build -f deploy/Dockerfile.web .`）
FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps ./apps

ARG VITE_API_BASE_URL=http://127.0.0.1:8080
ARG VITE_CONSOLE_PUBLIC_REGISTER=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_CONSOLE_PUBLIC_REGISTER=$VITE_CONSOLE_PUBLIC_REGISTER

# 仅安装 @zhizhu/web 依赖树，不安装 client/runner/e2e 等 workspace
RUN npm ci -w @zhizhu/web --include-workspace-root \
  && npm run build -w @zhizhu/web

FROM nginx:1.27-alpine
# 显式安装 curl 供 compose healthcheck 使用（不依赖 busybox wget applet 是否存在）
RUN apk add --no-cache curl
COPY deploy/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
