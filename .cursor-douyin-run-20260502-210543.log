ivity_video_type":0,"boost_status":0,"create_scale_type":null,"entertainment_product_info":{"sub_title":null,"market_info":{"limit_free":{"in_free":false},"marketing_tag":null}},"caption":"五一去北京四天该怎么玩？这份超详细攻略，吃住行全搞定#北京旅游 #北京旅游攻略 #北京旅行 #北京旅行攻略 #北京跟团游","item_title":"","is_use_music":false,"original":0,"xigua_base_info":{"status":0,"star_altar_order_id":0,"star_altar_type":0,"item_id":0},"mark_largely_following":false,"friend_recommend_info":{"friend_recommend_source":10,"label_user_list":null,"disable_friend_recommend_guide_label":false},"enable_comment_sticker_rec":false,"video_share_edit_status":0,"is_24_story":0,"recommend_chapter_info":{"recommend_chapter_list":[{"desc":"引言","timestamp":0,"detail":"","points":[]},{"desc":"注意事项","timestamp":7500,"detail":"","points":[{"desc":"・北京旅游核心注意事项","detail":"1. 住宿攻略：首选地铁1、2号线沿线（前门、王府井、崇文门、西单），性价比选三环地铁口，避开五环；\n2. 美食建议：避开游客扎堆的南锣鼓巷，选择本地人常去的牛街、护国寺、簋街；\n3. 交通指南：优先选地铁出行，避开早晚高峰；去八达岭长城优先选清河站高铁，20分钟直达；\n4. 门票预约：北京部分景点需提前预约，需关注对应景点放票时间","type":1}]},{"desc":"第一天","timestamp":48000,"detail":"","points":[{"desc":"・北京第一天行程指南","detail":"1. 升旗仪式：天安门广场看升旗免费，需提前7天预约；\n2. 人民大会堂：门票30元，提前3天晚5点放票，周一闭馆，禁带液体、零食、充电宝等；\n3. 毛主席纪念堂：免费，提前6天12:30放票，周一闭馆，仅上午开放且禁带包；\n4. 国家博物馆：免费，提前7天晚5点放票，周一闭馆，建议从负一楼古代中国展馆开始游览，看凤冠需早去排队","type":1}]},{"desc":"第二天","timestamp":90000,"detail":"","points":[{"desc":"・北京第二天行程指南","detail":"1. 颐和园：淡季门票20元、旺季30元，无需提前预约，曾是慈禧太后的后花园；\n2. 圆明园：建议购买25元联票，无需预约，重点参观西洋楼遗址；\n3. 清华北大：两校相邻，免费但需提前7天预约，感受学府氛围；\n4. 什刹海：免费免预约，可体验地道老北京烟火气","type":1}]},{"desc":"第三天","timestamp":116500,"detail":"","points":[{"desc":"・北京第三天行程指南","detail":"1. 城楼游览：门票15元，提前7天晚5点放票，周一闭馆，禁带包；\n2. 故宫博物院：淡季门票40元、旺季60元，需提前预约，时间紧张可沿中轴线游览前三殿和三宫六院；\n3. 景山公园：门票2元，无需预约，登顶可俯瞰紫禁城全景；\n4. 前门大街：免费免预约，可逛相邻的大栅栏，选购伴手礼","type":1}]},{"desc":"第四天","timestamp":150000,"detail":"","points":[{"desc":"・北京第四天行程指南","detail":"1. 八达岭长城：门票40元，无需预约；可坐缆车往返140元，登顶北八楼体验豪迈情怀；\n2. 天坛公园：需购买联票（淡季28元、旺季34元）才能参观祈年殿，周一不开放，是明清帝王祭祀场所","type":1}]}],"chapter_recommend_type":1,"chapter_abstract":"五一北京四天游攻略，包括住宿、美食、交通和景点安排。建议游览天安门广场、人民大会堂、纪念堂、国博、颐和园、圆明园、清华大学、什刹海、城楼、故宫、景山公园、前门大街、八达岭长城和天坛公园。注意提前预约部分景点门票，选择合适的交通方式和住宿地点。","chapter_recommend_source":2,"push_scene":[],"chapter_bar_color":null},"trends_infos":null,"chapter_bar_color":null,"flash_mob_trends":0,"ent_log_extra":{"log_extra":"{\"global_log_extra\":null,\"page_log_extra\":null,\"aweme_log_extra\":{\"ce_current_group_id\":\"7627755558116961649\",\"author_id\":\"104387699496\"},\"extra_log_extra\":null}"},"personal_page_botton_diagnose_style":0}],"time_list":["2026·05","2026·04","2026·03","2026·02","2026·01","2025·12","2025·03"],"log_pb":{"impr_id":"20260502210546912E95B7753BE8885230"},"request_item_cursor":0,"post_serial":2,"replace_series_cover":1},{"status_code":0,"min_cursor":1775859540000,"max_cursor":1773186720000,"has_more":1,"aweme_list":[{"aweme_id":"7627042282751146491","desc":"北京自由行四天游玩攻略游玩顺序#北京旅游 #北京旅游攻略 #北京旅行 #北京旅行攻略 #北京跟团游","create_time":1775859540,"author":{"uid":"104387699496","interest_tags":null,"nickname":"北京导游-七七","card_sort_priority":null,"user_tags":null,"avatar_thumb":{"uri":"100x100/aweme-avatar/tos-cn-avt-0015_10b8270482287a3bcb851243fe44ec5e","url_list":["https://p3-pc.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_10b8270482287a3bcb851243fe44ec5e.jpeg?from=327834062"],"width":720,"height":720},"private_relation_list":null,"endorsement_info_list":null,"follow_status":0,"special_people_labels":null,"hide_self_recommend_interest":0,"familiar_visitor_user":null,"custom_verify":"","display_info":null,"card_entries_not_display":null,"user_permissions":null,"profile_component_disabled":null,"ban_user_functions":null,"share_info":{"share_url":"","share_weibo_desc":"","share_desc":"","share_title":"","share_qrcode_url":{"uri":"311290007ae2948b09fd8","url_list":["https://p9-pc-sign.douyinpic.com/obj/311290007ae2948b09fd8?lk3s=138a59ce&x-expires=1777748400&x-signature=XHKW5ruQ%2FZPDGpflkoqEIBe9CMY%3D&from=327834062","https://p3-pc-sign.douyinpic.com/obj/311290007ae2948b09fd8?lk3s=138a59ce&x-expires=1