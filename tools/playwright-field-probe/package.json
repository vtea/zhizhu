{
  "name": "playwright-field-probe",
  "private": true,
  "type": "module",
  "dependencies": {
    "@zhizhu/playwright-browser-fingerprint": "*",
    "@zhizhu/playwright-shell-contract": "*"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "login": "tsx src/login.ts",
    "login:persistent": "tsx src/login.ts --persistent",
    "login:persistent:jiacheng": "PLAYWRIGHT_BROWSER_PROFILE=jiacheng-guoji tsx src/login.ts --persistent",
    "profile:unlock": "tsx src/unlock-profile.ts",
    "profile:unlock:jiacheng": "PLAYWRIGHT_BROWSER_PROFILE=jiacheng-guoji tsx src/unlock-profile.ts",
    "probe": "tsx src/probe.ts",
    "probe:persistent": "tsx src/probe.ts --persistent",
    "probe:headed": "tsx src/probe.ts --headed",
    "probe:persistent:headed": "tsx src/probe.ts --persistent --headed",
    "probe:anonymous": "tsx src/probe.ts --anonymous",
    "probe:douyin-short": "tsx src/douyinShortUrlProbe.ts",
    "dump-menu-keys": "tsx src/dump-menu-keys.ts",
    "probe:verify:clue-tabs": "sh scripts/verify-clue-list-tabs.sh"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "playwright": "^1.59.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
