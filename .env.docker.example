# Docker Compose 部署用环境变量（复制为仓库根 `.env`）
# 一键脚本 deploy/deploy.sh 会自动生成/补全多数键；也可手动复制本文件后修改。
#
#   cp .env.docker.example .env
#   docker compose build && docker compose up -d

# --- Compose 变量替换（构建 Web、映射端口）---
# 浏览器访问控制台的根地址（无尾斜杠）；改域名后须 docker compose build web
PUBLIC_ORIGIN=http://localhost:8080
WEB_HOST_PORT=8080

# --- 内置 Postgres（与 docker-compose.yml 默认帐号一致）---
POSTGRES_USER=zhizhu
POSTGRES_PASSWORD=zhizhu
POSTGRES_DB=zhizhu
DATABASE_URL=postgresql://zhizhu:zhizhu@postgres:5432/zhizhu

# 使用外置 RDS 时：只保留 DATABASE_URL 指向外库，并采用 deploy/docker-compose.external-db.yml.example

# --- API 鉴权（生产必填；deploy.sh 缺失时会自动生成）---
JWT_SECRET=
DEVICE_TOKEN_SECRET=

# --- CORS / 公开控制台地址（须与 PUBLIC_ORIGIN 一致）---
CORS_STRICT=1
CORS_ORIGIN=http://localhost:8080
CONSOLE_WEB_PUBLIC_URL=http://localhost:8080

# --- 自助注册（生产建议关闭）---
CONSOLE_ALLOW_PUBLIC_REGISTER=false
VITE_CONSOLE_PUBLIC_REGISTER=false

# --- 可选：邮件 SMTP（见根 .env.example）---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=noreply@example.com
